# Speaking Duck (OpenAI) — backend process environment only.
# The React app never receives these values.
#
# FastAPI/uvicorn do NOT auto-load this file. Copy to `.env` (gitignored) and
# export into the shell before starting the backend, for example:
#
#   set -a && source .env && set +a
#   cd backend && uv run uvicorn duck_wake_lab.main:app --reload --port 8000
#
# Physics endpoints (/api/health, /api/wake, /api/wave-field) work without a key.
# Only POST /api/duck/explain requires OPENAI_API_KEY.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_S=30
OPENAI_MAX_OUTPUT_TOKENS=300
